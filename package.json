{
  "name": "mcp-ondemand",
  "version": "1.1.0",
  "description": "Run MCP servers only while they are used. One proxy lists every tool from cache; each server starts on its first call and stops when idle.",
  "type": "module",
  "bin": {
    "mcp-ondemand": "bin/mcp-ondemand.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/proxy.test.mjs test/claude-config.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "proxy",
    "lazy-loading",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elis132/mcp-ondemand.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  }
}
