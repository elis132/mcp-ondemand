{
  "name": "@elis132/mcp-ondemand",
  "version": "1.5.0",
  "description": "Run MCP servers only while they are used: one proxy lists every tool from cache, starts each server on its first call, shares it between sessions and stops it when idle.",
  "type": "module",
  "bin": {
    "mcp-ondemand": "bin/mcp-ondemand.mjs"
  },
  "files": [
    "bin",
    "src",
    "bench",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/proxy.test.mjs test/shared.test.mjs test/claude-config.test.mjs test/client-config.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "proxy",
    "lazy-loading",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elis132/mcp-ondemand.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  },
  "homepage": "https://github.com/elis132/mcp-ondemand#readme",
  "bugs": {
    "url": "https://github.com/elis132/mcp-ondemand/issues"
  },
  "author": "elis132",
  "publishConfig": {
    "access": "public"
  }
}
